# Application
APP_ENV=development
APP_NAME=BlackSharkCars
APP_VERSION=1.0.0
DEBUG=true

# PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/blacksharkcars

# JWT
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_REFRESH_SECRET_KEY=change-me-in-production-use-a-different-long-random-string
JWT_ALGORITHM=HS256$env:PGPASSWORD = "postgres"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Storage (local | s3)
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./storage/uploads
STORAGE_PUBLIC_URL=http://localhost:8000/static
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT_URL=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@blacksharkcars.local
SMTP_FROM_NAME=BlackSharkCars

# Rate limiting
RATE_LIMIT_PER_MINUTE=120

# Listing
LISTING_AUTO_APPROVE=true
LISTING_EXPIRY_DAYS=60

# Upload limits
MAX_UPLOAD_SIZE_MB=15
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_VIDEO_TYPES=video/mp4,video/webm

# Super Admin (used only by seed script)
SUPER_ADMIN_EMAIL=admin@blacksharkcars.local
SUPER_ADMIN_PASSWORD=ChangeMe!2025